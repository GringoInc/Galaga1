+// ---------- Caché de caras (rendimiento) ----------
+// Dibujar una cara implica decenas de trazos y degradados; hacerlo para cada
+// personaje en cada cuadro es lo más caro del render. Aquí cada cara se pinta
+// UNA sola vez en un lienzo fuera de pantalla y luego se estampa con un único
+// drawImage por cuadro. La clave incluye si ya llegó la foto real, así el
+// caché se renueva solo cuando el sprite pasa de ilustración a fotografía.
+const _faceCache = new Map();
+let _faceKeyN = 0;
+const _faceKeys = new WeakMap();   // identidad estable por función/sprite
+function faceKey(o){
+  let k = _faceKeys.get(o);
+  if(k==null){ k = ++_faceKeyN; _faceKeys.set(o, k); }
+  return k;
+}
+// La caja del caché cubre el dibujo más extenso (camiseta hasta +1.9r,
+// insignia hasta ±1.32r, melenas hasta +1.45r) con un pequeño margen.
+const FACE_PAD_X = 1.5, FACE_PAD_TOP = 1.5, FACE_PAD_BOT = 2.1;
+function cachedStamp(key, r, x, y, painter){
+  const scale = Math.min(window.devicePixelRatio || 1, 3);
+  const k = key + ':' + r + ':' + scale;
+  let c = _faceCache.get(k);
+  if(!c){
+    const w = Math.ceil(r * FACE_PAD_X * 2);
+    const h = Math.ceil(r * (FACE_PAD_TOP + FACE_PAD_BOT));
+    const off = document.createElement('canvas');
+    off.width = Math.ceil(w * scale); off.height = Math.ceil(h * scale);
+    const octx = off.getContext('2d');
+    octx.setTransform(scale, 0, 0, scale, 0, 0);
+    const prev = ctx; ctx = octx;                       // redirige el dibujo
+    try{ painter(r * FACE_PAD_X, r * FACE_PAD_TOP, r); }
+    finally{ ctx = prev; }                              // y restaura SIEMPRE
+    c = { cv: off, w, h, ox: r * FACE_PAD_X, oy: r * FACE_PAD_TOP };
+    _faceCache.set(k, c);
+  }
+  ctx.drawImage(c.cv, x - c.ox, y - c.oy, c.w, c.h);
+}
 // Pinta un personaje: usa la foto si está lista, si no la ilustración
 function paintFace(sprite, drawFn, x, y, r){
-  if(sprite && sprite.ready && drawSprite(sprite, x, y, r)) return;
-  drawFn(x, y, r);
+  if(sprite && sprite.ready){
